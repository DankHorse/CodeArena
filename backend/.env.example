# Copy this file to .env and replace the local password before starting PostgreSQL.
APP_NAME=HackFlow API
API_V1_PREFIX=/api/v1
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=hackflow
POSTGRES_USER=hackflow
POSTGRES_PASSWORD=replace-with-your-own-url-safe-local-password
POSTGRES_PORT=55433
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
