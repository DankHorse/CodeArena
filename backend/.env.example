# Copy this file to .env and replace the local password before starting PostgreSQL.
APP_NAME=HackFlow API
API_V1_PREFIX=/api/v1
DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=hackflow
POSTGRES_USER=hackflow
POSTGRES_PASSWORD=replace-with-your-own-url-safe-local-password
POSTGRES_PORT=55433
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Generate a unique secret for each environment (at least 32 characters).
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_COOKIE_NAME=codearena_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
